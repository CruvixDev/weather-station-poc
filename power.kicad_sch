	(text_box "The TPS61169 WLED (White LED) driver is a boost converter\nregulated in current through FB pin. The driver uses a 204mV\nvoltage reference and the resistor on FB pin set the current\nthreshold -> 204mV / 1.5 ohm = 136 mA. To have full brightness on\n5\" Riverdi screen, 140 mA are needed. To control the brightness,\na PWM signal is injected on CTRL pin. 100% duty cycle is full\nbrightness, 50% half brightness and so on ... "
		(exclude_from_sim no)
		(at 64.77 144.78 0)
		(size 53.34 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "46da6dd3-cad8-430a-932f-733e4de729c2")
	)
